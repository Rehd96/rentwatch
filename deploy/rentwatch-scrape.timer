[Unit]
Description=Run rentwatch scrape every 4 hours

[Timer]
# 00:00, 04:00, 08:00, 12:00, 16:00, 20:00 — plus up to 20 minutes of jitter so
# we are not knocking on immobiliare.it exactly on the hour like a robot.
OnCalendar=*-*-* 00/4:00:00
RandomizedDelaySec=20min
# Catch up on a slot missed while the machine was off instead of waiting
# another four hours.
Persistent=true

[Install]
WantedBy=timers.target
