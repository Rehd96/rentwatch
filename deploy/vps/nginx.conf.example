# rentwatch behind nginx on labustagialla.it, at /case/.
#
# These two blocks go INSIDE the existing `server { ... }` for labustagialla.it
# (/etc/nginx/sites-available/writerblog), next to the portfolio and blog
# blocks — not in a server block of their own. That server already holds the
# certificate for this host; a second one for the same name would just fight
# with it.
#
# No auth_basic any more: the dashboard has its own login, which also covers
# anyone who reaches 127.0.0.1:8777 without passing through nginx at all.

location /case/ {
    # The trailing slash on proxy_pass strips "/case" before the app sees it;
    # --root-path /case in the unit file puts it back on links and cookies.
    proxy_pass http://127.0.0.1:8777/;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Without this, /case without the slash 404s instead of reaching the dashboard.
location = /case {
    return 301 /case/;
}
