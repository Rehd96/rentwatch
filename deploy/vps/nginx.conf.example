# TODO: scaffold non ancora testato — vedi TODO.md
# /etc/nginx/sites-available/rentwatch — poi: ln -s + nginx -t + systemctl reload nginx
# HTTPS: eseguire `certbot --nginx -d case.tuodominio.it` dopo aver puntato il DNS.
#
# Basic auth (OBBLIGATORIA prima di esporre — dati e link personali):
#   sudo apt install apache2-utils
#   sudo htpasswd -c /etc/nginx/rentwatch.htpasswd rentwatch

server {
    listen 80;
    server_name case.tuodominio.it;   # TODO: dominio reale

    auth_basic "rentwatch";
    auth_basic_user_file /etc/nginx/rentwatch.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8777;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
